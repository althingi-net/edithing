{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.9.2"
  },
  "main": "dist/index.js",
  "scripts": {
    "start": "nodemon --exec ts-node src/index.ts --watch src & npm run queue",
    "build": "NODE_ENV=production tsc --build",
    "prebuild": "npm run clean",
    "clean": "rimraf ./dist coverage *.tsbuildinfo",
    "reset": "npm run db:seed && npm run reset-git-merger",
    "test": "NODE_ENV=test jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:sdk": "openapi -i http://localhost:3003/api/spec.json -o ../client-sdk/src",
    "db:start": "docker-compose up -d",
    "db:destroy": "docker-compose down -v",
    "db:seed": "ts-node ./src/bin/seedDb.ts && npm run reset-git-merger",
    "db:shell": "ts-node ./src/bin/dbShell.ts",
    "queue": "ts-node ./src/bin/queueWorker.ts",
    "validate": "ts-node ./src/bin/filterInvalidDocuments.ts",
    "reset-git-merger": "ts-node ./src/bin/resetGitMerger.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/multer": "^3.0.2",
    "@koa/router": "^13.1.0",
    "amqplib": "^0.10.5",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "class-validator-jsonschema": "^5.0.1",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^4.5.2",
    "git-json-merger": "file:../git-json-merger",
    "http-status-codes": "^2.3.0",
    "koa": "^2.15.4",
    "koa-bodyparser": "^4.4.1",
    "koa-helmet": "^8.0.1",
    "koa-json": "^2.0.2",
    "koa-logger": "^3.2.1",
    "koa-passport": "^6.0.0",
    "koa2-swagger-ui": "^5.11.0",
    "law-document": "file:../law-document",
    "mysql": "^2.18.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.10.4",
    "routing-controllers-openapi": "^4.1.0",
    "text-diff": "^1.0.1",
    "typeorm": "^0.3.20",
    "typeorm-extension": "^3.6.3",
    "typescript": "^5.7.3",
    "xml-formatter": "^3.6.4"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/escape-html": "^1.0.4",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-json": "^2.0.23",
    "@types/koa-logger": "^3.1.5",
    "@types/koa-passport": "^6.0.3",
    "@types/node": "^22.13.4",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "eslint-import-resolver-typescript": "^3.8.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.6.1",
    "openapi-typescript-codegen": "^0.29.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.24.1"
  }
}
