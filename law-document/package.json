    "ctix": "^2.7.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.8.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "slate": "^0.112.0",
    "slate-history": "^0.100.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
